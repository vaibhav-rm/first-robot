<?xml version="1.0"?>
<!--
  my_robot - 4-wheeled differential-drive robot for Gazebo Sim (Harmonic/Ignition)
  =================================================================================
  - Chassis: box 0.6 (x) * 0.4 (y) * 0.2 (z)
  - Wheels: 4 x cylinder (r=0.10, width=0.05)
      * rear_left / rear_right  -> DRIVEN (DiffDrive plugin)
      * front_left / front_right -> PASSIVE (free-spinning continuous joints)
    This satisfies "box with four wheels" while keeping a standard 2-wheel
    diff-drive kinematic model (front wheels mimic passive casters/rollers).
  - Topics:
      * /cmd_vel            (geometry_msgs/Twist, input)
      * /wheel/odom         (nav_msgs/Odometry, diff-drive raw odometry)
      * /scan               (sensor_msgs/LaserScan, 360-ray lidar)
      * /imu/data           (sensor_msgs/Imu)
      * /gps/fix            (sensor_msgs/NavSatFix)
      * /camera/image_raw   (sensor_msgs/Image, RGB)
      * /camera/depth_image (sensor_msgs/Image, depth)
      * /camera/camera_info (sensor_msgs/CameraInfo)
      * /camera/points      (sensor_msgs/PointCloud2)
-->
<robot name="my_robot">

  <!-- ================= MATERIALS ================= -->
  <material name="grey"><color rgba="0.7 0.7 0.7 1"/></material>
  <material name="green"><color rgba="0 0.6 0 1"/></material>
  <material name="dark_grey"><color rgba="0.3 0.3 0.3 1"/></material>

  <!-- ================= BASE ================= -->
  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <geometry><box size="0.6 0.4 0.2"/></geometry>
      <material name="green"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <geometry><box size="0.6 0.4 0.2"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.2" iyy="0.2" izz="0.2"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ================= DRIVEN REAR WHEELS ================= -->
  <link name="rear_left_wheel">
    <visual>
      <geometry><cylinder radius="0.1" length="0.05"/></geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.1" length="0.05"/></geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.02" iyy="0.02" izz="0.02"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel"/>
    <origin xyz="-0.15 0.20 0.10" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="rear_right_wheel">
    <visual>
      <geometry><cylinder radius="0.1" length="0.05"/></geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.1" length="0.05"/></geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.02" iyy="0.02" izz="0.02"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <origin xyz="-0.15 -0.20 0.10" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Backwards-compatible aliases: many tutorials expect
       left_wheel_joint / right_wheel_joint. Gazebo allows only one
       joint per link, so we keep thin alias links? Instead we document:
       use rear_* joints as the actuated pair. For compatibility with old
       launch/bridge configs that reference left_wheel_joint, the DiffDrive
       plugin below uses rear joints. -->

  <!-- ================= PASSIVE FRONT WHEELS ================= -->
  <link name="front_left_wheel">
    <visual>
      <geometry><cylinder radius="0.1" length="0.05"/></geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.1" length="0.05"/></geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    </collision>
    <inertial>
      <mass value="0.8"/>
      <inertia ixx="0.015" iyy="0.015" izz="0.015"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_left_wheel"/>
    <origin xyz="0.20 0.20 0.10" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="front_right_wheel">
    <visual>
      <geometry><cylinder radius="0.1" length="0.05"/></geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.1" length="0.05"/></geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    </collision>
    <inertial>
      <mass value="0.8"/>
      <inertia ixx="0.015" iyy="0.015" izz="0.015"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_right_wheel"/>
    <origin xyz="0.20 -0.20 0.10" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ================= LIDAR ================= -->
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.05" length="0.05"/></geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.05" length="0.05"/></geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.005" iyy="0.005" izz="0.005"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.25" rpy="0 0 0"/>
  </joint>

  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <topic>scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <update_rate>10</update_rate>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>10.0</max>
        </range>
      </lidar>
      <always_on>1</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

  <!-- ================= DEPTH CAMERA ================= -->
  <link name="depth_camera_link">
    <visual>
      <geometry><box size="0.05 0.05 0.05"/></geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <geometry><box size="0.05 0.05 0.05"/></geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.002" iyy="0.002" izz="0.002"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="depth_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="depth_camera_link"/>
    <origin xyz="0.30 0 0.20" rpy="0 0 0"/>
  </joint>

  <gazebo reference="depth_camera_link">
    <sensor name="depth_camera" type="depth_camera">
      <topic>camera</topic>
      <gz_frame_id>depth_camera_link</gz_frame_id>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>10.0</far>
        </clip>
      </camera>
      <!--
        Gazebo Sim depth_camera sensor publishes under the <topic> namespace:
          camera/image_raw   (RGB)
          camera/depth_image (depth, meters)
          camera/camera_info
          camera/points      (PointCloud2)
        Bridge these in launch with ros_gz_bridge parameter_bridge.
      -->
    </sensor>
  </gazebo>

  <!-- ================= IMU ================= -->
  <link name="imu_link">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
  </joint>

  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <topic>imu/data</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <update_rate>100</update_rate>
      <always_on>1</always_on>
      <visualize>false</visualize>
    </sensor>
  </gazebo>

  <!-- ================= GPS ================= -->
  <link name="gps_link">
    <visual>
      <geometry><box size="0.06 0.06 0.03"/></geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <geometry><box size="0.06 0.06 0.03"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="gps_joint" type="fixed">
    <parent link="base_link"/>
    <child link="gps_link"/>
    <origin xyz="-0.10 0 0.22" rpy="0 0 0"/>
  </joint>

  <gazebo reference="gps_link">
    <sensor name="gps" type="navsat">
      <topic>gps/fix</topic>
      <gz_frame_id>gps_link</gz_frame_id>
      <update_rate>10</update_rate>
      <always_on>1</always_on>
    </sensor>
  </gazebo>

  <!-- ================= DIFF DRIVE ================= -->
  <!-- Subscribes: cmd_vel (geometry_msgs/Twist)
       Publishes:  wheel/odom (nav_msgs/Odometry) + odom -> base_footprint TF -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>0.40</wheel_separation>
      <wheel_radius>0.1</wheel_radius>
      <odom_publish_frequency>50</odom_publish_frequency>
      <topic>cmd_vel</topic>
      <odom_topic>wheel/odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <min_velocity>-1.0</min_velocity>
      <max_velocity>1.0</max_velocity>
      <min_acceleration>-2.0</min_acceleration>
      <max_acceleration>2.0</max_acceleration>
    </plugin>
  </gazebo>

  <!-- ================= JOINT STATE PUBLISHER ================= -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <joint_name>rear_left_wheel_joint</joint_name>
      <joint_name>rear_right_wheel_joint</joint_name>
      <joint_name>front_left_wheel_joint</joint_name>
      <joint_name>front_right_wheel_joint</joint_name>
    </plugin>
  </gazebo>

</robot>
